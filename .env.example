# Copiar a .env y rellenar. .env NO se sube al repositorio.
BOT_TOKEN=

# LLM: endpoint compatible con OpenAI (OpenAI oficial o un servidor local como Ollama en http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20

# Webhook (opcional): dominio con HTTPS y secreto para validar que Telegram envia las actualizaciones
WEBHOOK_DOMAIN=https://bh23004.duckdns.org
WEBHOOK_SECRET=

# Enlace de soporte humano que comparte el bot al crear un ticket
SUPPORT_URL=https://t.me/soporte_tienda
